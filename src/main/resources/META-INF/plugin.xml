<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.solmano.datagen</id>
    <name>Datagen</name>
    <vendor email="rinat.solmano@gmail.com">rsolmano</vendor>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.DatagenBundle</resource-bundle>

    <actions>
        <action
                id="com.solmano.GenerateFullNameAction"
                class="com.solmano.datagen.actions.GenerateFullNameAction"
                text="Full Name"
                description="Generate and insert realistic full name (first + last)"
                icon="/icons/datagen14x14.svg">
            <add-to-group group-id="GenerateGroup" anchor="first"/>
        </action>
        <action
                id="com.solmano.GenerateLastNameAction"
                class="com.solmano.datagen.actions.GenerateLastNameAction"
                text="Last Name"
                description="Generate and insert realistic last name"
                icon="/icons/datagen14x14.svg">
            <add-to-group group-id="GenerateGroup" anchor="first"/>
        </action>
        <action
                id="com.solmano.GenerateFirstNameAction"
                class="com.solmano.datagen.actions.GenerateFirstNameAction"
                text="First Name"
                description="Generate and insert realistic first name"
                icon="/icons/datagen14x14.svg">
            <add-to-group group-id="GenerateGroup" anchor="first"/>
        </action>
        <action
                id="com.solmano.GenerateEmailAction"
                class="com.solmano.datagen.actions.GenerateEmailAction"
                text="Email Address"
                description="Generate and insert realistic email address"
                icon="/icons/datagen14x14.svg">
            <add-to-group group-id="GenerateGroup" anchor="first"/>
        </action>
        <action
                id="com.solmano.Generate1to999999Action"
                class="com.solmano.datagen.actions.Generate1to999999Action"
                text="Int from 1 to 999999"
                description="Generate and insert int from 1 to 999999"
                icon="/icons/datagen14x14.svg">
            <add-to-group group-id="GenerateGroup" anchor="first"/>
        </action>
        <action
                id="com.solmano.Generate1to999Action"
                class="com.solmano.datagen.actions.Generate1to999Action"
                text="Int from 1 to 999"
                description="Generate and insert int from 1 to 999"
                icon="/icons/datagen14x14.svg">
            <add-to-group group-id="GenerateGroup" anchor="first"/>
        </action>
        <action
                id="com.solmano.GenerateUUIDAction"
                class="com.solmano.datagen.actions.GenerateUUIDAction"
                text="UUID"
                description="Generate and insert new UUID"
                icon="/icons/datagen14x14.svg">
            <add-to-group group-id="GenerateGroup" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
